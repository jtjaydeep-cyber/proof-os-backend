const { PrismaClient } = require('@prisma/client');
const prisma = new PrismaClient();

async function main() {
  console.log('⚡ Connecting to Proof OS Database...');
  
  // 1. Create a Test User
  const newUser = await prisma.user.create({
    data: {
      email: 'founder@proof-os.io',
      identityTrustLevel: 'LEVEL_1',
      updatedAt: new Date(),
    },
  });
  console.log('✅ User created:', newUser);

  // 2. Attach an Evidence Artifact to the User
  const newEvidence = await prisma.evidenceArtifact.create({
    data: {
      userId: newUser.id,
      title: 'Initial Proof OS Engine Build',
      description: 'Deployed core Prisma PostgreSQL schema via Termux and Render.',
      eClass: 'CLASS_A',
      sourceUri: 'https://github.com/your-org/proof-os-backend',
      aiConfidenceScore: 0.99,
      observedAt: new Date(),
    },
  });
  console.log('✅ Evidence Artifact generated:', newEvidence);
}

main()
  .catch((e) => console.error('❌ Error:', e))
  .finally(async () => await prisma.$disconnect());
